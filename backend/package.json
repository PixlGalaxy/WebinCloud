{
  "name": "webincloud-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=dev.env --env-file-if-exists=../.env --include ../locales/*.json --include ../.env src/index.ts",
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "migrate": "tsx --env-file=dev.env --env-file-if-exists=../.env src/db/migrate.ts"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "argon2": "^0.45.2",
    "better-sqlite3": "^13.2.0",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.6",
    "express": "^5.3.0",
    "maxmind": "^5.1.0",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/busboy": "^1.5.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/ws": "8.18.2",
    "tsx": "^4.7.0",
    "typescript": "~7.0.2"
  },
  "overrides": {
    "readdir-glob": {
      "minimatch": "11.0.5"
    }
  }
}
