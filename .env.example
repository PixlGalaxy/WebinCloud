# Copy to .env and adjust. All values shown are the container defaults.
#
# Almost everything below can also be changed after deployment from the Admin
# Panel's Settings page (no .env edit, no container recreate) — these are just
# the starting values for a brand-new install. The admin account itself is no
# longer created from .env at all: see "Accounts and sessions" below.

# ---------------------------------------------------------------------------
# Customization
# ---------------------------------------------------------------------------

# UI and API message language: en | es
LANGUAGE=en

# App title, app name, default theme/skin and the logo/icon/favicon are all
# editable from Admin Panel -> Settings once the app is running, with no
# restart needed. There's nothing to set here for a first boot.

# ---------------------------------------------------------------------------
# Accounts and sessions
# ---------------------------------------------------------------------------

# There's no ADMIN_EMAIL/ADMIN_USERNAME/ADMIN_PASSWORD anymore: the first boot
# always seeds "admin" / "changeme", and logging in with that exact pair forces
# you to immediately choose a new username, email and password before anything
# else is reachable. This means the real credentials never have to live in
# plaintext in an env var.

# Session lifetime in hours. Also caps how long a user can set the inactivity
# "auto sign-out" timer to in Settings (never more than the session itself
# lasts). Editable later from Admin Panel -> Settings (requires a backend
# restart to apply).
SESSION_TTL_HOURS=24

# Set to true only when serving over HTTPS, otherwise the cookie is never
# returned. Editable later from Admin Panel -> Settings (requires a backend
# restart to apply).
COOKIE_SECURE=false

# Max login attempts allowed per IP and per account within the window below,
# before further attempts get a 429. Applies to both independently, so one IP
# hammering many accounts and many IPs hammering one account are both capped.
# Editable later from Admin Panel -> Settings (requires a backend restart to apply).
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Same idea for guessing a share link's password, per IP and per share.
# Editable later from Admin Panel -> Settings (requires a backend restart to apply).
SHARE_UNLOCK_RATE_LIMIT_MAX=10
SHARE_UNLOCK_RATE_LIMIT_WINDOW_MINUTES=15

# ---------------------------------------------------------------------------
# Storage and internals
# ---------------------------------------------------------------------------

# Seconds without a progress poll before a running ZIP is cancelled. Editable
# later from Admin Panel -> Settings (requires a backend restart to apply).
ARCHIVE_ABANDON_SECONDS=30

# Optional: powers the country map on the admin dashboard with a local MaxMind
# GeoLite2-Country database (downloaded on first boot, refreshed weekly). Get a
# free key at https://www.maxmind.com/en/geolite2/signup. Without it, the map
# just shows no dots — nothing else is affected. Editable later from Admin
# Panel -> Settings (requires a backend restart to apply).
# MAXMIND_LICENSE_KEY=

# Volume mount points inside the container. Override only for custom layouts.
# DATA_ROOT=/data
# APPDATA_ROOT=/appdata
# TEMP_ROOT=/temp
# THUMBNAILS_DIR=/temp/thumbnails
# FFMPEG_PATH=ffmpeg
# LOCALES_DIR=/app/locales
# BRANDING_DIR=/appdata/branding
# GEOIP_DIR=/appdata/geoip
