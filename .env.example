# Copy to .env and adjust. All values shown are the container defaults.

# ---------------------------------------------------------------------------
# Customization
# ---------------------------------------------------------------------------

# UI and API message language: en | es
LANGUAGE=en

# Default appearance: dark | light. Each visitor's own toggle is remembered in
# a cookie and takes precedence over this.
THEME=dark

# Shown in the browser tab.
APP_TITLE=Webin Cloud Server

# Product name used in UI copy and image alt text.
APP_NAME=Webin Cloud

# The logo and icons are files, not settings: replace them in the app data
# volume at /appdata/branding (logo.png, icon.png, favicon.ico). The defaults
# are copied there on first boot, and a reload picks up any change.

# ---------------------------------------------------------------------------
# Accounts and sessions
# ---------------------------------------------------------------------------

# Initial admin account, created only while the user table is empty.
ADMIN_EMAIL=admin@itzgalaxy.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Session lifetime in hours.
SESSION_TTL_HOURS=24

# Set to true only when serving over HTTPS, otherwise the cookie is never returned.
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Storage and internals
# ---------------------------------------------------------------------------

# Seconds without a progress poll before a running ZIP is cancelled.
ARCHIVE_ABANDON_SECONDS=30

# Volume mount points inside the container. Override only for custom layouts.
# DATA_ROOT=/data
# APPDATA_ROOT=/appdata
# TEMP_ROOT=/temp
# THUMBNAILS_DIR=/temp/thumbnails
# FFMPEG_PATH=ffmpeg
# LOCALES_DIR=/app/locales
# BRANDING_DIR=/appdata/branding
