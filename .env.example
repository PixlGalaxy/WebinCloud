
# UI and API message language: en | es
LANGUAGE=en

# Default appearance: dark | light. Each visitor's own toggle is remembered in a
THEME=dark

# Initial admin account, created only while the user table is empty.
ADMIN_EMAIL=admin@itzgalaxy.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Session lifetime in hours.
SESSION_TTL_HOURS=24

# Set to true only when serving over HTTPS, otherwise the cookie is never returned.
COOKIE_SECURE=false

# Volume mount points inside the container. Override only for custom layouts.
# DATA_ROOT=/data
# APPDATA_ROOT=/appdata
# TEMP_ROOT=/temp
# LOCALES_DIR=/app/locales
